# Required Django secret. Replace with a generated, private value in local .env.
DJANGO_SECRET_KEY=replace-with-a-random-secret-key

# Local defaults
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_ENGINE=sqlite
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
INFERENCE_SERVICE_URL=http://127.0.0.1:8001
AI_ARTIFACTS_DIR=../ai-service/models

# Production security setting (used when DJANGO_DEBUG=False)
DJANGO_SECURE_HSTS_SECONDS=31536000

# Optional PostgreSQL configuration. Set DB_ENGINE=postgres and provide all values.
# POSTGRES_DB=deeppredict
# POSTGRES_USER=deeppredict
# POSTGRES_PASSWORD=replace-with-a-private-password
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Optional production email configuration
# DJANGO_EMAIL_HOST=localhost
# DJANGO_EMAIL_PORT=25
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_EMAIL_USE_TLS=False
